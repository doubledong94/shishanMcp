{
  "name": "shishan-mcp-backend",
  "version": "0.1.0",
  "description": "shishan MCP server (Streamable HTTP) — NestJS shell that calls Python/C++/TS tool logic",
  "private": true,
  "license": "MIT",
  "main": "dist/main-http.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --entryFile main-http",
    "start": "node dist/main-http.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@rekog/mcp-nest": "^1.9.10",
    "neo4j-driver": "^5.28.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.22.0"
  }
}
